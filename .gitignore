# secrets — never commit
credentials.json
token.json
token.pickle

# data + uploads (not re-obtainable / private)
uploads/
study.db
study.db-wal
study.db-shm
study.db.bak.*
exports/
# local DB backups — git does NOT protect the data (see backup.py); these are
# the real safety net, kept out of version control.
backups/
studydash.log

# python
venv/
__pycache__/
*.pyc
.DS_Store
.pytest_cache/
.ruff_cache/

# runtime setting overrides (app-written; keeps tracked settings.json pristine)
settings.local.json

# distributable packs (built by pack.py; rebuildable, never versioned)
dist/
