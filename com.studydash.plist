<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Auto-start StudyDash on login and keep it running.
  Install:
    cp com.studydash.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.studydash.plist
  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.studydash.plist
    rm ~/Library/LaunchAgents/com.studydash.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.studydash</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/shunjiro88/Desktop/StudyDash/venv/bin/python</string>
    <string>/Users/shunjiro88/Desktop/StudyDash/app.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/shunjiro88/Desktop/StudyDash</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/shunjiro88/Desktop/StudyDash/studydash.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/shunjiro88/Desktop/StudyDash/studydash.log</string>
</dict>
</plist>
